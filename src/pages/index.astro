---
import Layout from "../layouts/Layout.astro";
import Signature from "../components/Signature.astro";
import AvatarCurator from "../components/AvatarCurator.astro";

const projects = [
  {
    id: "rbl",
    title: "RBL Capital",
    status: "open source",
    description:
      "A simulated proprietary trading research system built to explore systematic edge across asset classes. Spans prediction markets, macro signals, equities, and mid-freq crypto desks.",
    tech: ["Python", "Polymarket", "Agent Frameworks", "Crypto Perps"],
    links: [
      {
        label: "Prediction Markets",
        url: "https://github.com/kadam-x/prediction-market-algo",
      },
      {
        label: "Tauric Research Fork",
        url: "https://github.com/kadam-x/TradingAgents",
      },
    ],
    emote:
      "I built this because prediction markets and DeFi are one of the few places where insider positioning is both legal and detectable.",
  },
  {
    id: "iv",
    title: "IV Surface Pipeline",
    status: "open source",
    description:
      "A full data engineering pipeline that ingests SPY options chain data daily, inverts Black-Scholes to compute implied volatility across all strikes and expiries, served via REST API and Grafana.",
    tech: ["Python", "Black-Scholes", "Data Warehouse", "REST API", "Grafana"],
    links: [
      {
        label: "Source",
        url: "https://github.com/kadam-x/volatility-surface-pipeline",
      },
      {
        label: "Docs",
        url: "https://github.com/kadam-x/volatility-surface-pipeline/blob/main/docs/architecture.md",
      },
    ],
    emote:
      "I wanted to build something that sits closer to how risk systems actually work than a typical portfolio project. Getting Brent's method to behave at the wings was the part that kept me up.",
  },
  {
    id: "catchwind",
    title: "Catch Wind",
    status: "closed source",
    description:
      "A dual-screen arcade shooter where you control two ships simultaneously. Each ship mirrors the other's movement but fires in opposite directions. Survive waves and unlock weapons.",
    tech: ["JavaScript", "Canvas", "Game Dev"],
    links: [],
    emote:
      "Two ships. One keyboard. Zero mercy. The core mechanic of mirrored movement but opposite firing directions creates this puzzle-like flow where you have to think about both sides simultaneously.",
  },
  {
    id: "nvim",
    title: "nvim-plugins",
    status: "open source",
    description:
      "A collection of personal Neovim plugins. Includes onyx-colorscheme, a dark, low-contrast colorscheme built for long sessions, and bufline.nvim, a minimal bufferline with diagnostics.",
    tech: ["Lua", "Neovim", "VimScript"],
    links: [
      {
        label: "onyx-colorscheme",
        url: "https://github.com/kadam-x/onyx-colorscheme/tree/main",
      },
      { label: "bufline.nvim", url: "https://github.com/kadam-x/bufline.nvim" },
    ],
    emote:
      "Every colorscheme I tried either burned my eyes or put me to sleep. So I made my own. Onyx is what happens when you spend too much time staring at a screen.",
  },
  {
    id: "portfolio",
    title: "Portfolio Website",
    status: "open source",
    description:
      "This very site, a personal portfolio built with Astro. Features a clean, academic-inspired UI, an animated robot mascot with dialogue system, and minimal project entries.",
    tech: ["Astro", "TypeScript"],
    links: [
      { label: "Source", url: "https://github.com/kadam-x/portfolio-website" },
    ],
    emote:
      "Built the whole thing in Astro. Wanted a clean, academic vibe that still felt polished. The robot was supposed to be a small easter egg but now she's basically the front desk.",
  },
];
---

<Layout title="Adam Kovacs">
  <div class="border-top"></div>
  <header class="header">
    <Signature />
    <a
      class="old-site-link"
      href="https://old.kovacsadam.dev"
      target="_blank"
      rel="noopener noreferrer"
      >Old Site</a
    >
  </header>

  <main class="content-box">
    <section id="intro" class="intro">
      <p class="bio">
        Building systems at the intersection of finance and code. I combine
        deep engineering with quantitative research to explore prediction
        markets, volatility modeling, and the occasional side quest in game
        dev.
      </p>
      <div class="links">
        <span class="link-item"
          ><span class="link-label">Email</span><span class="email-copy-wrap"
            ><button
              class="email-copy"
              type="button"
              data-email="contact.jumbo009@passinbox.com"
              >contact.jumbo009@passinbox.com</button
            ><span class="copy-hint">(click to copy)</span></span
          ></span
        >
        <span class="link-item"
          ><span class="link-label">GitHub</span><a
            href="https://github.com/kadam-x"
            target="_blank"
            rel="noopener noreferrer">@kadam-x</a
          ></span
        >
      </div>
    </section>

    <section id="projects" class="projects">
      <h2>Projects</h2>
      <div class="project-list">
          {
            projects.map((project) => (
              <article class="project-entry" data-id={project.id}>
                <h3 class="entry-title">
                  <button
                    class="entry-note"
                    type="button"
                    data-emote={project.emote}
                    aria-label={`Info about ${project.title}`}
                  >
                    ?
                  </button>
                  {project.title}
                  <span class="entry-status">— {project.status}</span>
                </h3>
                <p class="entry-desc">
                  {project.description} Built with {project.tech.join(", ")}.
                </p>
                <div class="entry-video">
                  <span>video placeholder</span>
                </div>
                <div class="entry-links">
                  {project.links.map((link) => (
                    <span class="link-item">
                      <span class="link-label">{link.label}</span>
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {link.url.replace(/^https?:\/\//, "")}
                      </a>
                    </span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
    </section>
  </main>

  <div class="border-bottom"></div>

  <AvatarCurator />

  <style>
    .border-top {
      width: 98%;
      height: 1.5px;
      background: var(--border);
      margin: 1.5rem auto 0;
    }

    .border-bottom {
      width: 98%;
      height: 1.5px;
      background: var(--border);
      margin: 0 auto 1.5rem;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 2rem;
      position: relative;
      z-index: 100;
    }

    .old-site-link {
      font-size: 0.875rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .content-box {
      max-width: 800px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .intro {
      min-height: 40vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .bio {
      font-size: 1.625rem;
      color: var(--fg);
      line-height: 1.7;
      max-width: 750px;
    }

    .links {
      margin-top: 1rem;
      margin-left: 1.25rem;
      padding-left: 0;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .link-item {
      display: grid;
      grid-template-columns: 9rem 1fr;
      font-size: 0.875rem;
      color: var(--fg);
    }

    .link-label {
      color: var(--fg-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.75rem;
    }

    .link-item a {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .email-copy-wrap {
      display: inline-flex;
      align-items: baseline;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .email-copy {
      background: none;
      border: none;
      padding: 0;
      margin: 0;
      font: inherit;
      color: var(--fg);
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }

    .copy-hint {
      color: var(--fg-muted);
      font-size: 0.75rem;
      text-decoration: none;
      transition: color 0.15s;
    }

    .copy-hint.copied {
      color: var(--fg);
    }

    .project-list {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      margin-top: 1.5rem;
    }

    .project-entry {
      margin-left: 1.25rem;
    }

    .entry-title {
      font-size: 1rem;
      font-weight: 600;
    }

    .entry-status {
      font-weight: 400;
      color: var(--fg-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.75rem;
    }

    .entry-desc {
      font-size: 0.9375rem;
      color: var(--fg-muted);
      line-height: 1.7;
      max-width: 700px;
      margin-top: 0.5rem;
    }

    .entry-video {
      margin-top: 0.75rem;
      margin-left: 1.25rem;
      width: 100%;
      max-width: 700px;
      aspect-ratio: 16 / 9;
      background: var(--fg-muted);
      opacity: 0.1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      color: var(--fg-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .entry-links {
      margin-top: 0.75rem;
      margin-left: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .entry-note {
      background: none;
      border: none;
      padding: 0;
      margin: 0;
      margin-right: 0.25rem;
      font: inherit;
      font-size: inherit;
      font-weight: 700;
      color: var(--fg);
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
      vertical-align: baseline;
    }

    .entry-note:hover {
      color: var(--fg-muted);
    }

    @media (max-width: 768px) {
      .header {
        padding: 1rem 1.5rem;
      }

      .content-box {
        padding: 0 1.5rem;
      }

      .old-site-link {
        font-size: 0.75rem;
      }

      .link-item {
        grid-template-columns: 6rem 1fr;
      }
    }
  </style>

  <script>
    function init() {
      document.querySelectorAll(".entry-note").forEach((btn) => {
        btn.addEventListener("click", () => {
          const text = btn.getAttribute("data-emote");
          if (text) {
            window.dispatchEvent(
              new CustomEvent("robot-emote", {
                detail: { text, expression: "talking" },
              }),
            );
          }
        });
      });

      document.querySelectorAll(".email-copy").forEach((btn) => {
        const hint = btn.parentElement?.querySelector(".copy-hint");
        const originalHint = hint?.textContent ?? "(click to copy)";
        let resetTimeout: ReturnType<typeof setTimeout> | undefined;

        btn.addEventListener("click", async () => {
          const email = btn.getAttribute("data-email");
          if (!email) return;

          try {
            await navigator.clipboard.writeText(email);
          } catch {
            const textarea = document.createElement("textarea");
            textarea.value = email;
            textarea.style.position = "fixed";
            textarea.style.opacity = "0";
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand("copy");
            document.body.removeChild(textarea);
          }

          if (hint) {
            clearTimeout(resetTimeout);
            hint.textContent = "copied to clipboard";
            hint.classList.add("copied");
            resetTimeout = setTimeout(() => {
              hint.textContent = originalHint;
              hint.classList.remove("copied");
            }, 1500);
          }
        });
      });
    }

    init();
    document.addEventListener("astro:page-load", init);
  </script>
</Layout>
