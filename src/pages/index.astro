---
import Layout from "../layouts/Layout.astro";
import Signature from "../components/Signature.astro";
import AvatarCurator from "../components/AvatarCurator.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import { projects } from "../data/projects";
---

<Layout title="Adam Kovacs">
  <div class="border-top"></div>
  <header class="header">
    <Signature />
    <a
      class="old-site-link"
      href="https://portfolio-website-lxa9otmei-kadamx.vercel.app/"
      target="_blank"
      rel="noopener noreferrer">Old Site</a
    >
  </header>

  <main class="content-box">
    <section id="intro" class="intro">
      <p class="bio">
        Building systems at the intersection of finance and code. I combine deep
        engineering with quantitative research to explore prediction markets,
        volatility modeling, and the occasional side quest in game dev.
      </p>
      <div class="links">
        <span class="link-item"
          ><span class="link-label">Email</span><span class="email-copy-wrap"
            ><button
              class="email-copy"
              type="button"
              data-email="contact.jumbo009@passinbox.com"
              >contact.jumbo009@passinbox.com</button
            ><span class="copy-hint">(click to copy)</span></span
          ></span
        >
        <span class="link-item"
          ><span class="link-label">GitHub</span><a
            href="https://github.com/kadam-x"
            target="_blank"
            rel="noopener noreferrer">@kadam-x</a
          ></span
        >
      </div>
    </section>

    <section id="projects" class="projects">
      <h2>Projects</h2>
      <div class="project-list">
        {projects.map((project) => <ProjectEntry project={project} />)}
      </div>
    </section>
  </main>

  <div class="border-bottom"></div>

  <AvatarCurator />

  <style>
    .border-top {
      width: 98%;
      height: 1.5px;
      background: var(--border);
      margin: 1.5rem auto 0;
    }

    .border-bottom {
      width: 98%;
      height: 1.5px;
      background: var(--border);
      margin: 0 auto 1.5rem;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 2rem;
      position: relative;
      z-index: 100;
    }

    .old-site-link {
      font-size: 0.875rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .content-box {
      max-width: 800px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .intro {
      min-height: 40vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .bio {
      font-size: 1.625rem;
      color: var(--fg);
      line-height: 1.7;
      max-width: 750px;
    }

    .links {
      margin-top: 1rem;
      margin-left: 1.25rem;
      padding-left: 0;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .link-item {
      display: grid;
      grid-template-columns: 9rem 1fr;
      font-size: 0.875rem;
      color: var(--fg);
    }

    .link-label {
      color: var(--fg-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.75rem;
    }

    .link-item a {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .email-copy-wrap {
      display: inline-flex;
      align-items: baseline;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .email-copy {
      background: none;
      border: none;
      padding: 0;
      margin: 0;
      font: inherit;
      color: var(--fg);
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }

    .copy-hint {
      color: var(--fg-muted);
      font-size: 0.75rem;
      text-decoration: none;
      transition: color 0.15s;
    }

    .copy-hint.copied {
      color: var(--fg);
    }

    .project-list {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      margin-top: 1.5rem;
    }

    @media (max-width: 768px) {
      .header {
        padding: 1rem 1.5rem;
      }

      .content-box {
        padding: 0 1.5rem;
      }

      .old-site-link {
        font-size: 0.75rem;
      }

      .link-item {
        grid-template-columns: 6rem 1fr;
      }
    }
  </style>

  <script>
    function init() {
      document.querySelectorAll(".entry-note").forEach((btn) => {
        btn.addEventListener("click", () => {
          const text = btn.getAttribute("data-emote");
          if (text) {
            window.dispatchEvent(
              new CustomEvent("robot-emote", {
                detail: { text, expression: "talking" },
              }),
            );
          }
        });
      });

      document.querySelectorAll(".email-copy").forEach((btn) => {
        const hint = btn.parentElement?.querySelector(".copy-hint");
        const originalHint = hint?.textContent ?? "(click to copy)";
        let resetTimeout: ReturnType<typeof setTimeout> | undefined;

        btn.addEventListener("click", async () => {
          const email = btn.getAttribute("data-email");
          if (!email) return;

          try {
            await navigator.clipboard.writeText(email);
          } catch {
            const textarea = document.createElement("textarea");
            textarea.value = email;
            textarea.style.position = "fixed";
            textarea.style.opacity = "0";
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand("copy");
            document.body.removeChild(textarea);
          }

          if (hint) {
            clearTimeout(resetTimeout);
            hint.textContent = "copied to clipboard";
            hint.classList.add("copied");
            resetTimeout = setTimeout(() => {
              hint.textContent = originalHint;
              hint.classList.remove("copied");
            }, 1500);
          }
        });
      });
    }

    init();
    document.addEventListener("astro:page-load", init);
  </script>
</Layout>
