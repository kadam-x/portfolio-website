---
import Layout from "../layouts/Layout.astro";
import TickerLanes from "../components/TickerLanes.astro";
import AvatarCurator from "../components/AvatarCurator.astro";

const projects = [
  {
    id: "rbl",
    title: "RBL Capital",
    description:
      "A simulated proprietary trading research system built to explore systematic edge across asset classes. Spans prediction markets, macro signals, equities, and mid-freq crypto desks.",
    tech: ["Python", "Polymarket", "Agent Frameworks", "Crypto Perps"],
    openSource: true,
    links: [
      { label: "Prediction Markets", url: "https://github.com/kadam-x/prediction-market-algo" },
      { label: "Tauric Research Fork", url: "https://github.com/kadam-x/TradingAgents" },
    ],
    emote: "I built this because prediction markets and DeFi are one of the few places where insider positioning is both legal and detectable.",
  },
  {
    id: "iv",
    title: "IV Surface Pipeline",
    description:
      "A full data engineering pipeline that ingests SPY options chain data daily, inverts Black-Scholes to compute implied volatility across all strikes and expiries, served via REST API and Grafana.",
    tech: ["Python", "Black-Scholes", "Data Warehouse", "REST API", "Grafana"],
    openSource: true,
    links: [
      { label: "Source", url: "https://github.com/kadam-x/volatility-surface-pipeline" },
      { label: "Docs", url: "https://github.com/kadam-x/volatility-surface-pipeline/blob/main/docs/architecture.md" },
    ],
    emote: "I wanted to build something that sits closer to how risk systems actually work than a typical portfolio project. Getting Brent's method to behave at the wings was the part that kept me up.",
  },
  {
    id: "catchwind",
    title: "Catch Wind",
    description:
      "A dual-screen arcade shooter where you control two ships simultaneously. Each ship mirrors the other's movement but fires in opposite directions. Survive waves and unlock weapons.",
    tech: ["JavaScript", "Canvas", "Game Dev"],
    openSource: false,
    links: [],
    emote: "Two ships. One keyboard. Zero mercy. The core mechanic of mirrored movement but opposite firing directions creates this puzzle-like flow where you have to think about both sides simultaneously.",
  },
  {
    id: "nvim",
    title: "nvim-plugins",
    description:
      "A collection of personal Neovim plugins. Includes onyx-colorscheme — a dark, low-contrast colorscheme built for long sessions — and bufline.nvim, a minimal bufferline with diagnostics.",
    tech: ["Lua", "Neovim", "VimScript"],
    openSource: true,
    links: [
      { label: "onyx-colorscheme", url: "https://github.com/kadam-x/onyx-colorscheme/tree/main" },
      { label: "bufline.nvim", url: "https://github.com/kadam-x/bufline.nvim" },
    ],
    emote: "Every colorscheme I tried either burned my eyes or put me to sleep. So I made my own. Onyx is what happens when you spend too much time staring at a screen.",
  },
  {
    id: "portfolio",
    title: "Portfolio Website",
    description:
      "This very site — a personal portfolio built with Astro. Features a retro-inspired UI, an animated robot mascot with dialogue system, and custom project cards.",
    tech: ["Astro", "Three.js", "React"],
    openSource: true,
    links: [
      { label: "Source", url: "https://github.com/kadam-x/portfolio-website" },
    ],
    emote: "Built the whole thing in Astro. Wanted a retro vibe that still felt polished. The robot was supposed to be a small easter egg but now she's basically the front desk.",
  },
];
---

<Layout title="kovacsadam.dev">
  <TickerLanes />

  <section id="hero" class="hero">
    <div class="container">
      <p class="hero-role">Software Engineer & Quantitative Researcher</p>
      <p class="hero-intro">
        Building systems at the intersection of finance and code.
        I combine deep engineering with quantitative research to explore
        prediction markets, volatility modeling, and the occasional side quest in game dev.
      </p>
      <p class="hero-cta">
        Interested in algo trading, quant research, or just want to talk shop?
      </p>
      <div class="hero-contacts">
        <span><span class="contact-label">github:</span> <a href="https://github.com/kadam-x" target="_blank" rel="noopener noreferrer">@kadam-x</a></span>
        <span><span class="contact-label">email:</span> <span id="copy-email-hero" class="copy-email">contact.jumbo009@passinbox.com</span><span id="copy-hint-hero" class="copy-hint">(click to copy)</span></span>
      </div>
    </div>
  </section>

  <section id="projects" class="projects">
    <div class="container">
      <div class="projects-grid">
        {projects.map((project) => (
          <article class="project-card" data-id={project.id}>
            <div class="card-header">
              <h3 class="card-title">{project.title}</h3>
              <span class={`card-visibility ${project.openSource ? "open" : "closed"}`}>
                {project.openSource ? "open source" : "closed source"}
              </span>
            </div>
            <div class="card-media">
              <div class="card-media-placeholder">
                <span class="card-media-icon">▶</span>
              </div>
            </div>
            <div class="card-body">
              <p class="card-desc">{project.description}</p>
              <div class="card-tech">
                {project.tech.map((t) => (
                  <span class="tech-badge">{t}</span>
                ))}
              </div>
              <div class="card-links">
                {project.links.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="card-link">
                    {link.label} ↗
                  </a>
                ))}
                <button class="card-info-btn" data-emote={project.emote} aria-label={`Info about ${project.title}`}>
                  ?
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <AvatarCurator />

  <style>
    .hero {
      min-height: auto;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 8rem 0 3rem;
      position: relative;
      z-index: 1;
    }

    .hero .container {
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .hero-role {
      font-family: var(--font-mono);
      font-size: clamp(1.2rem, 3vw, 2rem);
      color: var(--fg-bright);
      font-weight: 600;
      letter-spacing: 0.04em;
      margin-bottom: 2rem;
      text-shadow: 0 0 40px rgba(0, 0, 0, 1), 0 6px 30px rgba(0, 0, 0, 1), 0 2px 10px rgba(0, 0, 0, 1);
    }

    .hero-intro {
      font-size: clamp(1rem, 1.5vw, 1.15rem);
      color: var(--fg);
      max-width: 620px;
      line-height: 1.7;
      margin-bottom: 2rem;
      text-shadow: 0 0 40px rgba(0, 0, 0, 1), 0 6px 30px rgba(0, 0, 0, 1), 0 2px 10px rgba(0, 0, 0, 1);
    }

    .hero-cta {
      font-size: clamp(0.9rem, 1.3vw, 1rem);
      color: var(--fg);
      margin-bottom: 1.5rem;
      text-shadow: 0 0 40px rgba(0, 0, 0, 1), 0 6px 30px rgba(0, 0, 0, 1), 0 2px 10px rgba(0, 0, 0, 1);
    }

    .hero-contacts {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--accent-cyan);
      text-shadow: 0 0 40px rgba(0, 0, 0, 1), 0 6px 30px rgba(0, 0, 0, 1), 0 2px 10px rgba(0, 0, 0, 1);
    }

    .hero-contacts a {
      color: var(--accent-cyan);
      font-weight: 500;
    }

    .contact-label {
      color: var(--fg-bright);
    }

    .projects {
      padding: 0 0 6rem;
      position: relative;
      z-index: 1;
    }

    .projects .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .project-card {
      background: var(--surface);
      border: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      transition: border-color 0.25s, box-shadow 0.25s;
    }

    .project-card:hover {
      border-color: var(--accent-orange);
      box-shadow: 0 4px 24px rgba(243, 139, 63, 0.15);
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      background: #161820;
      border-bottom: 1px solid var(--border);
    }

    .card-title {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--fg-bright);
      margin: 0;
    }

    .card-visibility {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.15rem 0.5rem;
      border: 1px solid;
    }

    .card-visibility.open {
      color: var(--accent-green);
      border-color: var(--accent-green);
    }

    .card-visibility.closed {
      color: var(--accent-red);
      border-color: var(--accent-red);
    }

    .card-media {
      aspect-ratio: 16 / 9;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .card-media-placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      color: var(--border);
    }

    .card-media-icon {
      font-size: 1.5rem;
      opacity: 0.4;
    }

    .card-body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex: 1;
      text-align: left;
    }

    .card-desc {
      font-size: 0.875rem;
      color: var(--fg);
      line-height: 1.6;
      margin-bottom: 1rem;
      flex: 1;
    }

    .card-tech {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 1rem;
    }

    .tech-badge {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      padding: 0.2rem 0.5rem;
      background: var(--bg);
      color: var(--accent-cyan);
      border: 1px solid var(--border);
      letter-spacing: 0.02em;
    }

    .card-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
    }

    .card-link {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent-orange);
      transition: color 0.2s;
    }

    .card-link:hover {
      color: var(--fg-bright);
    }

    .card-info-btn {
      margin-left: auto;
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
    }

    .card-info-btn:hover {
      border-color: var(--accent-orange);
      color: var(--accent-orange);
    }

    .copy-email {
      color: var(--accent-cyan);
      font-weight: 500;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .copy-email:hover {
      opacity: 0.8;
    }

    .copy-hint {
      font-size: 0.7rem;
      opacity: 0.35;
      margin-left: 0.5rem;
    }

    @media (max-width: 1100px) {
      .hero .container,
      .projects .container {
        max-width: 100%;
      }
    }

    @media (max-width: 1024px) {
      .projects-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      .projects-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        padding: 6rem 0 1rem;
      }
    }
  </style>

  <script>
    function init() {
      const email = "contact.jumbo009@passinbox.com";

      document.querySelectorAll("[id^='copy-email']").forEach((btn) => {
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(email);
            const hintId = btn.id.replace("copy-email", "copy-hint");
            const hint = document.getElementById(hintId);
            if (hint) {
              hint.textContent = "(copied!)";
              setTimeout(() => {
                hint.textContent = "(click to copy)";
              }, 2000);
            }
          } catch (err) {
            console.error("Failed to copy:", err);
          }
        });
      });

      document.querySelectorAll(".card-info-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const text = btn.getAttribute("data-emote");
          if (text) {
            window.dispatchEvent(
              new CustomEvent("robot-emote", {
                detail: { text, expression: "talking" },
              })
            );
          }
        });
      });
    }

    init();
    document.addEventListener("astro:page-load", init);
  </script>
</Layout>
