---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-entry" data-id={project.id}>
  <h3 class="entry-title">
    <button
      class="entry-note"
      type="button"
      data-emote={project.emote}
      aria-label={`Info about ${project.title}`}
    >
      ?
    </button>
    {project.title}
    <span class="entry-status">— {project.status}</span>
  </h3>
  <p class="entry-desc">
    {project.description} Built with {project.tech.join(", ")}.
  </p>
  <div class="entry-video">
    <span>video placeholder</span>
  </div>
  <div class="entry-links">
    {project.links.map((link) => (
      <span class="link-item">
        <span class="link-label">{link.label}</span>
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {link.url.replace(/^https?:\/\//, "")}
        </a>
      </span>
    ))}
  </div>
</article>

<style>
  .project-entry {
    margin-left: 1.25rem;
  }

  .entry-title {
    font-size: 1rem;
    font-weight: 600;
  }

  .entry-status {
    font-weight: 400;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
  }

  .entry-desc {
    font-size: 0.9375rem;
    color: var(--fg-muted);
    line-height: 1.7;
    max-width: 700px;
    margin-top: 0.5rem;
  }

  .entry-video {
    margin-top: 0.75rem;
    margin-left: 1.25rem;
    width: 100%;
    max-width: 700px;
    aspect-ratio: 16 / 9;
    background: var(--fg-muted);
    opacity: 0.1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .entry-links {
    margin-top: 0.75rem;
    margin-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .link-item {
    display: grid;
    grid-template-columns: 9rem 1fr;
    font-size: 0.875rem;
    color: var(--fg);
  }

  .link-label {
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
  }

  .link-item a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .entry-note {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    margin-right: 0.25rem;
    font: inherit;
    font-size: inherit;
    font-weight: 700;
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    vertical-align: baseline;
  }

  .entry-note:hover {
    color: var(--fg-muted);
  }

  @media (max-width: 768px) {
    .link-item {
      grid-template-columns: 6rem 1fr;
    }
  }
</style>
