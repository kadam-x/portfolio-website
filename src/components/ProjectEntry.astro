---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<details class="project-entry">
  <summary class="entry-summary">
    <span class="entry-title">{project.title}</span>
    <span class="entry-status">— {project.status}</span>
    <svg
      class="entry-chevron"
      viewBox="0 0 12 12"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M2 4.5 6 8.5 10 4.5"></path>
    </svg>
  </summary>
  <div class="entry-body">
    <p class="entry-desc">
      {project.description} Built with {project.tech.join(", ")}.
    </p>
    <div class="entry-video">
      <span>video placeholder</span>
    </div>
    <div class="entry-links">
      {project.links.map((link) => (
        <span class="link-item">
          <span class="link-label">{link.label}</span>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {link.url.replace(/^https?:\/\//, "")}
          </a>
        </span>
      ))}
    </div>
    <details class="entry-insight">
      <summary class="insight-toggle">Additional notes</summary>
      <p class="insight-text">{project.insight}</p>
    </details>
  </div>
</details>

<style>
  .project-entry {
    margin-left: 1.25rem;
  }

  .project-entry summary {
    list-style: none;
    cursor: pointer;
  }

  .project-entry summary::-webkit-details-marker {
    display: none;
  }

  .entry-summary {
    display: flex;
    align-items: baseline;
    gap: 0;
  }

  .entry-chevron {
    width: 0.75rem;
    height: 0.75rem;
    margin-left: auto;
    padding-left: 0;
    flex-shrink: 0;
    align-self: center;
    color: var(--fg-muted);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .project-entry[open] > .entry-summary .entry-chevron {
    transform: translateY(0.15rem);
  }

  .entry-title {
    font-size: 1rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .entry-status {
    padding-left: 0.75rem;
    font-weight: 400;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .entry-desc {
    font-size: 0.9375rem;
    color: var(--fg-muted);
    line-height: 1.7;
    max-width: 700px;
    margin-top: 0.5rem;
  }

  .entry-video {
    margin-top: 0.75rem;
    margin-left: 1.25rem;
    width: 100%;
    max-width: 700px;
    aspect-ratio: 16 / 9;
    background: var(--fg-muted);
    opacity: 0.1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .entry-links {
    margin-top: 0.75rem;
    margin-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .link-item {
    display: grid;
    grid-template-columns: 9rem 1fr;
    font-size: 0.875rem;
    color: var(--fg);
  }

  .link-label {
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
  }

  .link-item a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .entry-insight {
    margin-top: 1rem;
    margin-left: 1.25rem;
  }

  .insight-toggle {
    display: flex;
    align-items: center;
    font-size: 0.75rem;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    transition: color 0.15s;
  }

  .insight-toggle:hover {
    color: var(--fg);
  }

  .insight-toggle::after {
    content: "";
    margin-left: 0.6rem;
    width: 0.35rem;
    height: 0.35rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.15rem) rotate(45deg);
    transition: transform 0.2s ease;
  }

  .entry-insight[open] > .insight-toggle::after {
    transform: translateY(0.1rem) rotate(-135deg);
  }

  .insight-text {
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    color: var(--fg-muted);
    font-style: italic;
    line-height: 1.7;
    max-width: 700px;
  }

  @media (max-width: 768px) {
    .link-item {
      grid-template-columns: 6rem 1fr;
    }
  }
</style>
