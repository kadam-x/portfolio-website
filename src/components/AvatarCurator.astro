<div id="avatar-container">
  <div id="avatar-bubble" class="hidden">
    <div class="bubble-content"></div>
    <div class="bubble-arrow"></div>
  </div>
  <div id="avatar-wrap">
    <img id="avatar-base" src="/avatar/idle.png" alt="avatar" width="240" />
    <img id="avatar-blink" src="/avatar/eyes-closed.png" alt="" aria-hidden="true" width="240" />
    <img id="avatar-talking" src="/avatar/talking.png" alt="" aria-hidden="true" width="240" />
  </div>
</div>

<script>
  let bubbleTimeout: ReturnType<typeof setTimeout> | null = null;
  let currentTypeId = 0;
  let blinkInterval: ReturnType<typeof setTimeout> | number | null = null;
  let isEmoting = false;

  function showDialogue(text: string) {
    const bubble = document.getElementById("avatar-bubble");
    const content = bubble?.querySelector(".bubble-content");
    if (!bubble || !content) return;

    clearTimeout(bubbleTimeout!);
    bubble.classList.remove("hidden");
    content.textContent = "";

    const typeId = ++currentTypeId;
    let i = 0;

    function type() {
      if (typeId !== currentTypeId) return;
      if (i < text.length) {
        content.textContent += text.charAt(i);
        i++;
        setTimeout(type, 7);
      }
    }
    type();

    bubbleTimeout = setTimeout(() => {
      if (typeId === currentTypeId) bubble.classList.add("hidden");
    }, 5500);
  }

  function setExpression(name: string) {
    const blink = document.getElementById("avatar-blink");
    const talking = document.getElementById("avatar-talking");
    if (!blink || !talking) return;
    blink.classList.remove("visible");
    talking.classList.remove("visible");
    if (name === "blink") blink.classList.add("visible");
    if (name === "talking") talking.classList.add("visible");
  }

  function triggerBlink() {
    if (isEmoting) return;
    setExpression("blink");
    setTimeout(() => {
      if (!isEmoting) setExpression("none");
    }, 180);
  }

  function stopBlinking() {
    if (blinkInterval !== null) {
      clearInterval(blinkInterval as number);
      clearTimeout(blinkInterval as ReturnType<typeof setTimeout>);
      blinkInterval = null;
    }
  }

  function startBlinking() {
    stopBlinking();
    blinkInterval = setInterval(() => {
      triggerBlink();
      const nextBlink = 2500 + Math.random() * 3000;
      clearInterval(blinkInterval as number);
      blinkInterval = setTimeout(startBlinking, nextBlink);
    }, 3000 + Math.random() * 2000);
  }

  function onRobotEmote(e: Event) {
    const { text, expression } = (e as CustomEvent).detail;
    const wrap = document.getElementById("avatar-wrap");
    if (!wrap) return;

    if (text) showDialogue(text);

    isEmoting = true;
    setExpression(expression === "talking" ? "talking" : "none");

    if (expression === "talking") {
      wrap.classList.add("bouncing");
    }

    setTimeout(() => {
      setExpression("none");
      isEmoting = false;
      if (wrap) wrap.classList.remove("bouncing");
    }, 1200);
  }

  function init() {
    stopBlinking();
    startBlinking();
    window.addEventListener("robot-emote", onRobotEmote);
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  #avatar-container {
    position: fixed;
    bottom: -0.5rem;
    left: 1.5rem;
    width: 200px;
    height: 260px;
    z-index: 100;
    pointer-events: none;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  #avatar-wrap {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 200px;
    height: 200px;
    transform: translateZ(0);
    backface-visibility: hidden;
    view-transition-name: none;
  }

  #avatar-wrap.bouncing {
    animation: bounce 0.25s ease-in-out infinite;
  }

  #avatar-base {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    view-transition-name: none;
  }

  #avatar-blink,
  #avatar-talking {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.05s;
    view-transition-name: none;
  }

  #avatar-blink.visible,
  #avatar-talking.visible {
    opacity: 1;
  }

  #avatar-bubble {
    position: absolute;
    bottom: 230px;
    left: 30px;
    background: var(--surface);
    border: 1px solid var(--accent-green);
    padding: 1rem 1.25rem;
    max-width: 260px;
    min-width: 200px;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    z-index: 20;
    transition: opacity 0.3s;
    white-space: normal;
    word-break: break-word;
  }

  #avatar-bubble.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .bubble-arrow {
    position: absolute;
    bottom: -11px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 10px solid transparent;
    border-right: 10px solid transparent;
    border-top: 10px solid var(--accent-green);
  }

  .bubble-arrow::after {
    content: "";
    position: absolute;
    top: -9px;
    left: -8px;
    width: 0;
    height: 0;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 8px solid var(--surface);
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-3px);
    }
  }
</style>
